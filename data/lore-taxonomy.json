  "description": "Generic lore identity graph for races, lineages, species, sects, tribes, factions, cultivation systems, and regions. Legacy game fields such as sect/race can coexist during migration.",
  "nodeKinds": {
    "race": "High-level race or realm-wide ancestry group.",
    "lineage": "A sub-race, bloodline, clan lineage, or large species family.",
    "species": "Concrete species or bloodline branch.",
    "sect": "Sect or school with inherited techniques and organization.",
    "tribe": "Tribal or nomadic political unit.",
    "faction": "Loose organization, alliance, valley, palace, market, or political power.",
    "path": "Cultivation system, identity, or technique tradition.",
    "region": "Geographic origin, realm, island sea, forbidden zone, or secret realm."
  },
  "edgeRelations": {
    "IS_A": "Child node belongs under parent node.",
    "AFFILIATED_WITH": "Node is politically or narratively associated with another node.",
    "SUBORDINATE_TO": "Node is under another organization's jurisdiction or hierarchy.",
    "HAS_CULTIVATION_SYSTEM": "Organization or group commonly uses a cultivation system.",
    "LOCATED_IN": "Node is primarily located in a region.",
    "ORIGINATES_FROM": "Node originates from a region or group.",
    "TEACHES": "Organization, lineage, or path teaches a technique, spell, formation, or doctrine.",
    "OWNS": "Hero or group owns an artifact, pet, treasure, or named object.",
    "USES_ARTIFACT": "Hero, group, or path is strongly associated with using an artifact.",
    "COUNTERS": "Node is narratively or mechanically favored against another node.",
    "SYNERGIZES_WITH": "Node has positive gameplay or lore synergy with another node.",
    "RESTRICTED_TO": "Card, artifact, technique, or identity is restricted to a node.",
    "SOURCE_OF": "Node is the source, material, or origin of another node."
  },
